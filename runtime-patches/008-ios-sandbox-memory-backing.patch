--- /dev/null
+++ b/include/rex/memory/ios_backing.h
@@ -0,0 +1,41 @@
+#pragma once
+
+#include <cerrno>
+#include <cstdlib>
+#include <fcntl.h>
+#include <limits>
+#include <string>
+#include <unistd.h>
+
+namespace rex::memory {
+
+// iOS denies POSIX shm_open in the app sandbox. An unlinked temporary file
+// supports the same MAP_SHARED aliases without a global shared-memory name.
+// ftruncate reserves a sparse logical size; it does not write 4.5 GiB of data.
+inline int CreateIosBackingFile(const std::string& directory, size_t length) {
+  if (directory.empty()) { errno = ENOENT; return -1; }
+  if (length > static_cast<size_t>(std::numeric_limits<off_t>::max())) {
+    errno = EFBIG;
+    return -1;
+  }
+  std::string name = directory + "/blur-memory-XXXXXX";
+  int fd = mkstemp(name.data());
+  if (fd < 0) return -1;
+  // Remove the name immediately, so process exit also reclaims the backing.
+  if (unlink(name.c_str()) != 0) {
+    const int error = errno;
+    close(fd);
+    errno = error;
+    return -1;
+  }
+  if (fcntl(fd, F_SETFD, FD_CLOEXEC) < 0 ||
+      ftruncate(fd, static_cast<off_t>(length)) != 0) {
+    const int error = errno;
+    close(fd);
+    errno = error;
+    return -1;
+  }
+  return fd;
+}
+
+}  // namespace rex::memory
