+bool VulkanCommandProcessor::AwaitQueueOperationsCompletionForPerformanceStats(
+    PerformanceStats::CpuWait wait) {
+  if (!performance_stats_->enabled()) {
+    return AwaitAllQueueOperationsCompletion();
+  }
+  const auto start = std::chrono::steady_clock::now();
+  const bool completed = AwaitAllQueueOperationsCompletion();
+  const auto elapsed = std::chrono::steady_clock::now() - start;
+  performance_stats_->RecordCpuWait(
+      wait, uint64_t(std::chrono::duration_cast<std::chrono::nanoseconds>(elapsed).count()));
+  return completed;
+}
