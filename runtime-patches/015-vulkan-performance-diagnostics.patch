diff --git a/include/rex/graphics/performance_stats.h b/include/rex/graphics/performance_stats.h
new file mode 100644
--- /dev/null
+++ b/include/rex/graphics/performance_stats.h
@@ -0,0 +1,89 @@
+#pragma once
+
+#include <atomic>
+#include <cstdint>
+
+namespace rex::graphics {
+
+// Cumulative diagnostics since graphics-system creation, recording only while
+// monitoring is enabled. Disabling or re-enabling does not reset the totals.
+// Fields are independently atomic snapshots, not a transaction across counters.
+struct PerformanceMetrics {
+  bool enabled = false;
+  // Guest draw commands recorded, excluding presentation and internal transfers.
+  uint64_t draw_calls = 0;
+  // IssueCopy calls accepted for processing; may include no-op/failed resolves.
+  uint64_t resolve_calls = 0;
+  // Successful guest command-buffer queue submissions, excluding presentation.
+  uint64_t queue_submissions = 0;
+  // Host occlusion-query end commands recorded.
+  uint64_t occlusion_query_ends = 0;
+  uint64_t occlusion_cpu_waits = 0;
+  uint64_t memexport_cpu_waits = 0;
+  // CPU wall time inside queue-completion awaits, not GPU execution time.
+  double occlusion_cpu_wait_ms = 0.0;
+  double memexport_cpu_wait_ms = 0.0;
+};
+
+// Shared by the Vulkan graphics system and command processor so snapshots never
+// access command-processor lifetime or non-atomic rendering state.
+class PerformanceStats {
+ public:
+  enum class CpuWait { kOcclusion, kMemexport };
+
+  void SetEnabled(bool enabled) { enabled_.store(enabled, std::memory_order_relaxed); }
+  bool enabled() const { return enabled_.load(std::memory_order_relaxed); }
+
+  PerformanceMetrics GetMetrics() const {
+    PerformanceMetrics metrics;
+    metrics.enabled = enabled();
+    metrics.draw_calls = draw_calls_.load(std::memory_order_relaxed);
+    metrics.resolve_calls = resolve_calls_.load(std::memory_order_relaxed);
+    metrics.queue_submissions = queue_submissions_.load(std::memory_order_relaxed);
+    metrics.occlusion_query_ends = occlusion_query_ends_.load(std::memory_order_relaxed);
+    metrics.occlusion_cpu_waits = occlusion_cpu_waits_.load(std::memory_order_relaxed);
+    metrics.memexport_cpu_waits = memexport_cpu_waits_.load(std::memory_order_relaxed);
+    metrics.occlusion_cpu_wait_ms =
+        double(occlusion_cpu_wait_ns_.load(std::memory_order_relaxed)) / 1000000.0;
+    metrics.memexport_cpu_wait_ms =
+        double(memexport_cpu_wait_ns_.load(std::memory_order_relaxed)) / 1000000.0;
+    return metrics;
+  }
+
+  void RecordDrawCall() { IncrementIfEnabled(draw_calls_); }
+  void RecordResolveCall() { IncrementIfEnabled(resolve_calls_); }
+  void RecordQueueSubmission() { IncrementIfEnabled(queue_submissions_); }
+  void RecordOcclusionQueryEnd() { IncrementIfEnabled(occlusion_query_ends_); }
+
+  void RecordCpuWait(CpuWait wait, uint64_t nanoseconds) {
+    if (!enabled()) {
+      return;
+    }
+    if (wait == CpuWait::kOcclusion) {
+      occlusion_cpu_waits_.fetch_add(1, std::memory_order_relaxed);
+      occlusion_cpu_wait_ns_.fetch_add(nanoseconds, std::memory_order_relaxed);
+    } else {
+      memexport_cpu_waits_.fetch_add(1, std::memory_order_relaxed);
+      memexport_cpu_wait_ns_.fetch_add(nanoseconds, std::memory_order_relaxed);
+    }
+  }
+
+ private:
+  void IncrementIfEnabled(std::atomic<uint64_t>& counter) {
+    if (enabled()) {
+      counter.fetch_add(1, std::memory_order_relaxed);
+    }
+  }
+
+  std::atomic<bool> enabled_{false};
+  std::atomic<uint64_t> draw_calls_{0};
+  std::atomic<uint64_t> resolve_calls_{0};
+  std::atomic<uint64_t> queue_submissions_{0};
+  std::atomic<uint64_t> occlusion_query_ends_{0};
+  std::atomic<uint64_t> occlusion_cpu_waits_{0};
+  std::atomic<uint64_t> memexport_cpu_waits_{0};
+  std::atomic<uint64_t> occlusion_cpu_wait_ns_{0};
+  std::atomic<uint64_t> memexport_cpu_wait_ns_{0};
+};
+
+}  // namespace rex::graphics
