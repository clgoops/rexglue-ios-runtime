+// A generation counter closes the race between checking several objects and
+// blocking. A signal wakes multi-object waiters immediately, rather than waiting
+// for a one-millisecond polling tick. Never hold this mutex while locking an
+// individual condition: signalers notify while holding their condition mutex.
+class MultiWaitNotification {
+ public:
+  uint64_t Snapshot() {
+    std::lock_guard lock(mutex_);
+    return generation_;
+  }
+  void Notify() {
+    {
+      std::lock_guard lock(mutex_);
+      ++generation_;
+    }
+    condition_.notify_all();
+  }
+  void WaitUntil(uint64_t observed, std::chrono::steady_clock::time_point deadline) {
+    std::unique_lock lock(mutex_);
+    auto changed = [&] { return generation_ != observed; };
+    if (deadline == std::chrono::steady_clock::time_point::max())
+      condition_.wait(lock, changed);
+    else
+      condition_.wait_until(lock, deadline, changed);
+  }
+ private:
+  std::mutex mutex_;
+  std::condition_variable condition_;
+  uint64_t generation_ = 0;
+};
+
+static MultiWaitNotification& GetMultiWaitNotification() {
+  static MultiWaitNotification notification;
+  return notification;
+}
