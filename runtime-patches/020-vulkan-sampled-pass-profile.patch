-void DeferredCommandBuffer::Execute(VkCommandBuffer command_buffer) {
+PassProfileCapture DeferredCommandBuffer::BuildPassProfile(uint64_t serial) const {
+  PassProfileCapture capture;
+  std::vector<PassProfileSegment> segments;
+  PassProfileSegment current;
+  PassProfileContext context;
+  bool inside = false;
+  auto finish = [&](size_t end) {
+    current.end = end;
+    if (current.HasWork()) {
+      current.ordinal = uint32_t(segments.size());
+      segments.push_back(current);
+    }
+    current = {}; current.begin = end;
+  };
+  size_t position = 0;
+  while (position < command_stream_.size()) {
+    const size_t begin = position;
+    if (command_stream_.size() - position < kCommandHeaderSizeElements) return {};
+    const auto& header = *reinterpret_cast<const CommandHeader*>(command_stream_.data() + position);
+    position += kCommandHeaderSizeElements;
+    if (header.arguments_size_elements > command_stream_.size() - position) return {};
+    const auto* args = command_stream_.data() + position;
+    const size_t end = position + header.arguments_size_elements;
+    switch (header.command) {
+      case Command::kProfileContext:
+        context = *reinterpret_cast<const PassProfileContext*>(args);
+        break;
+      case Command::kVkBeginRendering: {
+        if (inside) return {};
+        const auto& a = *reinterpret_cast<const ArgsVkBeginRendering*>(args);
+        // Never insert timestamps in suspended/resumed, secondary or multiview rendering.
+        if (a.flags || a.view_mask || a.layer_count != 1) return {};
+        finish(begin); inside = true; current.render = 1;
+        current.width = a.render_area.extent.width; current.height = a.render_area.extent.height;
+        current.colors = a.color_attachment_count; current.depth = a.has_depth_attachment;
+      } break;
+      case Command::kVkBeginRenderPass: {
+        if (inside) return {};
+        const auto& a = *reinterpret_cast<const ArgsVkBeginRenderPass*>(args);
+        if (a.contents != VK_SUBPASS_CONTENTS_INLINE) return {};
+        finish(begin); inside = true; current.render = 1;
+        current.width = a.render_area.extent.width; current.height = a.render_area.extent.height;
+      } break;
+      case Command::kVkEndRendering:
+      case Command::kVkEndRenderPass:
+        if (!inside) return {};
+        finish(end); inside = false; context = {};
+        break;
+      case Command::kVkDraw:
+      case Command::kVkDrawIndexed:
+        ++current.draws; current.Include(context); break;
+      case Command::kVkDispatch:
+        ++current.dispatches; current.Include(context); break;
+      case Command::kVkCopyBuffer:
+      case Command::kVkCopyBufferToImage:
+      case Command::kVkCopyQueryPoolResults:
+        ++current.copies; current.Include(context); break;
+      case Command::kVkClearAttachments:
+      case Command::kVkClearColorImage:
+        ++current.clears; current.Include(context); break;
+      case Command::kVkPipelineBarrier: ++current.barriers; break;
+      default: break;
+    }
+    position = end;
+    if (segments.size() > 8192) return {};  // Bound temporary profiling memory.
+  }
+  if (inside) return {};
+  finish(position);
+  capture.population = uint32_t(segments.size());
+  if (!capture.population) return capture;
+  capture.count = std::min<uint32_t>(PassProfileCapture::kMaxSamples, capture.population);
+  // A deterministic rotating window covers stable command streams without
+  // repeatedly selecting the first pass. Population/ordinal are exported too.
+  const uint32_t first = uint32_t((serial % capture.population) * capture.count % capture.population);
+  for (uint32_t i = 0; i < capture.count; ++i)
+    capture.segments[i] = segments[(first + i) % capture.population];
+  return capture;
+}
+
