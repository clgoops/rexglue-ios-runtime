diff --git a/include/rex/graphics/vulkan/pass_profile.h b/include/rex/graphics/vulkan/pass_profile.h
new file mode 100644
--- /dev/null
+++ b/include/rex/graphics/vulkan/pass_profile.h
@@ -0,0 +1,60 @@
+#pragma once
+
+#include <array>
+#include <cmath>
+#include <cstddef>
+#include <cstdint>
+#include <vulkan/vulkan.h>
+
+namespace rex::graphics::vulkan {
+
+// Diagnostic metadata only. None of these types cross the runtime/plugin ABI.
+enum class PassDomain : uint32_t {
+  kUnknown = 0, kGuest = 1, kOwnership = 2, kResolve = 4, kDisplay = 8,
+};
+struct PassProfileContext {
+  PassDomain domain = PassDomain::kUnknown;
+  uint64_t vertex_shader = 0, pixel_shader = 0;
+};
+struct PassProfileSegment {
+  size_t begin = 0, end = 0;
+  uint32_t ordinal = 0, render = 0, domains = 0;
+  uint32_t width = 0, height = 0, colors = 0, depth = 0;
+  uint32_t draws = 0, dispatches = 0, copies = 0, clears = 0, barriers = 0;
+  uint64_t vertex_shader = 0, pixel_shader = 0;
+  bool guest_shader_seen = false, mixed_shaders = false;
+
+  void Include(PassProfileContext context) {
+    domains |= uint32_t(context.domain);
+    if (context.domain != PassDomain::kGuest) return;
+    if (!guest_shader_seen) {
+      vertex_shader = context.vertex_shader; pixel_shader = context.pixel_shader;
+      guest_shader_seen = true;
+    } else if (vertex_shader != context.vertex_shader || pixel_shader != context.pixel_shader) {
+      mixed_shaders = true;
+    }
+  }
+  bool HasWork() const { return draws || dispatches || copies || clears || barriers; }
+};
+
+struct PassProfileCapture {
+  static constexpr uint32_t kMaxSamples = 8;
+  static constexpr uint32_t kQueryCount = 2 * kMaxSamples;
+  VkQueryPool pool = VK_NULL_HANDLE;
+  uint64_t frame = 0;
+  uint32_t count = 0, population = 0;
+  std::array<PassProfileSegment, kMaxSamples> segments{};
+};
+
+// Availability is checked after the existing submission fence. No waiting or
+// speculative reads of unavailable query values are permitted.
+inline bool PassProfileNanoseconds(const uint64_t* values, uint32_t valid_bits,
+                                   double period, double& nanoseconds) {
+  if (!valid_bits || valid_bits > 64 || !std::isfinite(period) || period <= 0 ||
+      !values[1] || !values[3]) return false;
+  const uint64_t mask = valid_bits == 64 ? UINT64_MAX : ((uint64_t(1) << valid_bits) - 1);
+  nanoseconds = double((values[2] - values[0]) & mask) * period;
+  return std::isfinite(nanoseconds) && nanoseconds >= 0;
+}
+
+}  // namespace rex::graphics::vulkan
