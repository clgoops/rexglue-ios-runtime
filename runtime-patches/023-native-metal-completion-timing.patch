diff --git a/thirdparty/moltenvk/MoltenVK/MoltenVK/Utility/REXNativeMetalTiming.h b/thirdparty/moltenvk/MoltenVK/MoltenVK/Utility/REXNativeMetalTiming.h
new file mode 100644
--- /dev/null
+++ b/thirdparty/moltenvk/MoltenVK/MoltenVK/Utility/REXNativeMetalTiming.h
@@ -0,0 +1,24 @@
+// SPDX-License-Identifier: Apache-2.0
+// Native command-buffer windows; this does not measure shader busy cycles.
+#pragma once
+#include <cmath>
+struct REXNativeMetalWindow {
+  bool valid_gpu=false;
+  double gpu_ms=-1, pre_gpu_ms=-1, driver_ms=-1, callback_lag_ms=-1;
+};
+inline REXNativeMetalWindow rexNativeMetalWindow(bool completed,double committed,
+    double gpu_start,double gpu_end,double kernel_start,double kernel_end,double callback) {
+  REXNativeMetalWindow result;
+  result.valid_gpu=completed && std::isfinite(gpu_start) && std::isfinite(gpu_end) &&
+                   gpu_start>0 && gpu_end>=gpu_start;
+  if(result.valid_gpu) {
+    result.gpu_ms=(gpu_end-gpu_start)*1000.0;
+    if(std::isfinite(committed) && committed>0 && gpu_start>=committed)
+      result.pre_gpu_ms=(gpu_start-committed)*1000.0;
+    if(std::isfinite(callback) && callback>=gpu_end)
+      result.callback_lag_ms=(callback-gpu_end)*1000.0;
+  }
+  if(std::isfinite(kernel_start) && std::isfinite(kernel_end) && kernel_start>0 && kernel_end>=kernel_start)
+    result.driver_ms=(kernel_end-kernel_start)*1000.0;
+  return result;
+}
