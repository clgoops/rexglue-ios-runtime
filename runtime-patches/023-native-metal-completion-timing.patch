+// Called before finish() destroys the submission. Only tagged guest buffers
+// are reported. This uses completed Metal properties, not counter samples,
+// synchronous waits, performanceTracking, or a change to semaphore handling.
+static void rexLogNativeMetalTiming(MVKBaseObject* owner,id<MTLCommandBuffer> buffer,
+                                    double committed) {
+  NSString* label=buffer.label;
+  if(![label hasPrefix:@"rex.native."]) return;
+  const double start=buffer.GPUStartTime,end=buffer.GPUEndTime;
+  const double kernel_start=buffer.kernelStartTime,kernel_end=buffer.kernelEndTime;
+  const double callback=double(mvkGetRuntimeNanoseconds())*1e-9;
+  const auto window=rexNativeMetalWindow(buffer.status==MTLCommandBufferStatusCompleted,
+      committed,start,end,kernel_start,kernel_end,callback);
+  owner->reportMessage(MVK_CONFIG_LOG_LEVEL_INFO,
+      "Native Metal window: label=%s valid=%d gpu_ms=%.6f pre_gpu_ms=%.6f driver_ms=%.6f callback_lag_ms=%.6f commit_s=%.9f gpu_start_s=%.9f gpu_end_s=%.9f callback_s=%.9f status=%ld",
+      label.UTF8String,int(window.valid_gpu),window.gpu_ms,window.pre_gpu_ms,window.driver_ms,
+      window.callback_lag_ms,committed,start,end,callback,long(buffer.status));
+}
