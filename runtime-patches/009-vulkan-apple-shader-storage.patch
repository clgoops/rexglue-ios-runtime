--- /dev/null
+++ b/include/rex/graphics/util/shader_storage.h
@@ -0,0 +1,15 @@
+#pragma once
+#include <cstdio>
+
+namespace rex::graphics {
+// On Darwin, a+b starts at EOF, unlike common Linux implementations. Always
+// rewind before validating a persistent cache header. Append writes stay at EOF.
+// Take ownership of the opened stream, including on a seek failure.
+inline FILE* PrepareShaderStorageRead(FILE* file) {
+  if (file && std::fseek(file, 0, SEEK_SET) != 0) {
+    std::fclose(file);
+    return nullptr;
+  }
+  return file;
+}
+}  // namespace rex::graphics
