diff --git a/src/graphics/vulkan/spirv_register_optimizer.cpp b/src/graphics/vulkan/spirv_register_optimizer.cpp
new file mode 100644
--- /dev/null
+++ b/src/graphics/vulkan/spirv_register_optimizer.cpp
@@ -0,0 +1,70 @@
+#include <rex/graphics/vulkan/spirv_register_optimizer.h>
+#include <spirv-tools/libspirv.hpp>
+#include <spirv-tools/optimizer.hpp>
+#include <spirv/unified1/spirv.hpp>
+#include <algorithm>
+#include <set>
+
+namespace rex::graphics::vulkan {
+namespace {
+using Contract=std::vector<std::vector<uint32_t>>;
+bool Inspect(std::span<const uint32_t> words, Contract& contract, uint32_t& loads,
+             uint32_t& stores, uint32_t& locals) {
+  if (words.size()<5 || words[0]!=spv::MagicNumber) return false;
+  std::set<uint32_t> global_ids;
+  for (size_t i=5;i<words.size();) {
+    const uint32_t size=words[i]>>16, op=words[i]&0xffff;
+    if (!size || size>words.size()-i) return false;
+    if ((op==spv::OpVariable && size>=4 && words[i+3]!=spv::StorageClassFunction) ||
+        (op>=spv::OpSpecConstantTrue && op<=spv::OpSpecConstantOp && size>=3))
+      global_ids.insert(words[i+2]);
+    i+=size;
+  }
+  for (size_t i=5;i<words.size();) {
+    const uint32_t size=words[i]>>16, op=words[i]&0xffff;
+    if (!size || size>words.size()-i) return false;
+    if (op==spv::OpLoad) ++loads;
+    if (op==spv::OpStore) ++stores;
+    if (op==spv::OpVariable && size>=4 && words[i+3]==spv::StorageClassFunction) ++locals;
+    const bool preserve=op==spv::OpEntryPoint || op==spv::OpExecutionMode || op==spv::OpExecutionModeId ||
+      (op==spv::OpVariable && size>=4 && words[i+3]!=spv::StorageClassFunction) ||
+      (op==spv::OpDecorate && size>=3 && global_ids.contains(words[i+1])) ||
+      op==spv::OpMemberDecorate ||
+      (op>=spv::OpSpecConstantTrue && op<=spv::OpSpecConstantOp);
+    if (preserve) contract.emplace_back(words.begin()+i,words.begin()+i+size);
+    i+=size;
+  }
+  std::sort(contract.begin(),contract.end());return true;
+}
+}
+bool OptimizeSpirvRegisters(std::span<const uint32_t> input, std::vector<uint32_t>& output,
+                            SpirvRegisterStats& stats, std::string& error) {
+  output.clear();stats={};error.clear();Contract before,after;
+  if (!Inspect(input,before,stats.loads_before,stats.stores_before,stats.function_variables_before)) {
+    error="Malformed SPIR-V";return false;
+  }
+  auto consumer=[&](spv_message_level_t,const char*,const spv_position_t&,const char* message) {
+    if (error.empty() && message) error=std::string(message).substr(0,300);
+  };
+  spvtools::Optimizer optimizer(SPV_ENV_VULKAN_1_2);
+  optimizer.SetMessageConsumer(consumer);
+  // Local register representation only: no half conversion, floating-point
+  // relaxation/reassociation, interface removal, loop unrolling or math folding.
+  optimizer.RegisterPass(spvtools::CreateScalarReplacementPass(256));
+  optimizer.RegisterPass(spvtools::CreateLocalAccessChainConvertPass());
+  optimizer.RegisterPass(spvtools::CreateLocalSingleBlockLoadStoreElimPass());
+  optimizer.RegisterPass(spvtools::CreateLocalSingleStoreElimPass());
+  optimizer.RegisterPass(spvtools::CreateSSARewritePass());
+  optimizer.RegisterPass(spvtools::CreateDeadInsertElimPass());
+  optimizer.RegisterPass(spvtools::CreateAggressiveDCEPass(true, false));
+  spvtools::OptimizerOptions options;
+  options.set_run_validator(true);options.set_preserve_bindings(true);options.set_preserve_spec_constants(true);
+  std::vector<uint32_t> candidate;
+  if (!optimizer.Run(input.data(),input.size(),&candidate,options)) return false;
+  spvtools::SpirvTools validator(SPV_ENV_VULKAN_1_2);validator.SetMessageConsumer(consumer);
+  if (!validator.Validate(candidate) || !Inspect(candidate,after,stats.loads_after,
+      stats.stores_after,stats.function_variables_after)) return false;
+  if (before!=after) {error="Shader interface/execution contract changed";return false;}
+  output=std::move(candidate);error.clear();return true;
+}
+}  // namespace rex::graphics::vulkan
diff --git a/include/rex/graphics/vulkan/spirv_register_optimizer.h b/include/rex/graphics/vulkan/spirv_register_optimizer.h
new file mode 100644
--- /dev/null
+++ b/include/rex/graphics/vulkan/spirv_register_optimizer.h
@@ -0,0 +1,16 @@
+#pragma once
+#include <cstdint>
+#include <span>
+#include <string>
+#include <vector>
+
+namespace rex::graphics::vulkan {
+struct SpirvRegisterStats {
+  uint32_t loads_before=0, loads_after=0, stores_before=0, stores_after=0;
+  uint32_t function_variables_before=0, function_variables_after=0;
+};
+// Output is committed only after validation and preservation of global variables,
+// execution modes, entry points and specialization constants. Failure leaves it empty.
+bool OptimizeSpirvRegisters(std::span<const uint32_t> input, std::vector<uint32_t>& output,
+                            SpirvRegisterStats& stats, std::string& error);
+}  // namespace rex::graphics::vulkan
