+void GraphicsSystem::InitializeShaderStorageWithCompletion(
+    const std::filesystem::path& cache_root, uint32_t title_id,
+    std::function<void()> completion) {
+  if (!command_processor_ || !REXCVAR_GET(store_shaders)) {
+    completion();
+    return;
+  }
+  // Never wait for shader compilation on the UIKit thread. Completion runs on
+  // the command thread, so callers marshal their launch continuation to the UI.
+  command_processor_->CallInThread([this, cache_root, title_id,
+                                    completion = std::move(completion)]() {
+    try {
+      command_processor_->InitializeShaderStorage(cache_root, title_id, true);
+    } catch (const std::exception& error) {
+      REXLOG_ERROR("Shader preparation failed: {}. Missing pipelines may compile during play.", error.what());
+    }
+    completion();
+  });
+}
