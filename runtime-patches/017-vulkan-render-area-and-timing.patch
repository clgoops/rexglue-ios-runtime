diff --git a/src/graphics/vulkan/deferred_command_buffer.cpp b/src/graphics/vulkan/deferred_command_buffer.cpp
--- a/src/graphics/vulkan/deferred_command_buffer.cpp
+++ b/src/graphics/vulkan/deferred_command_buffer.cpp
@@ -30,6 +30,108 @@
 
 void DeferredCommandBuffer::Reset() {
   command_stream_.clear();
+}
+
+
+// Bound only dynamic LOAD/STORE passes. Their complete command stream is already
+// known here, so include every draw scissor and every explicit clear rectangle.
+// Keep the original area for unknown state, resolves, attachment clears/discards,
+// multiview, secondary/suspended rendering, empty passes, and legacy render passes.
+DeferredCommandBuffer::RenderAreaStats DeferredCommandBuffer::OptimizeRenderAreas(bool enabled) {
+  RenderAreaStats stats;
+  ArgsVkBeginRendering* begin = nullptr;
+  VkRect2D scissor = {};
+  bool scissor_known = false, safe = false, touched = false;
+  int64_t left=0, top=0, right=0, bottom=0;
+  auto include = [&](VkRect2D rect) {
+    if (!begin || !safe) return;
+    const VkRect2D& full = begin->render_area;
+    const int64_t x0 = std::max<int64_t>(full.offset.x,rect.offset.x);
+    const int64_t y0 = std::max<int64_t>(full.offset.y,rect.offset.y);
+    const int64_t x1 = std::min(int64_t(full.offset.x)+full.extent.width,
+                               int64_t(rect.offset.x)+rect.extent.width);
+    const int64_t y1 = std::min(int64_t(full.offset.y)+full.extent.height,
+                               int64_t(rect.offset.y)+rect.extent.height);
+    if (x1<=x0 || y1<=y0) return;
+    if (!touched) { left=x0;top=y0;right=x1;bottom=y1;touched=true; }
+    else { left=std::min(left,x0);top=std::min(top,y0);
+           right=std::max(right,x1);bottom=std::max(bottom,y1); }
+  };
+  auto finish = [&]() {
+    if (!begin) return;
+    ++stats.passes;
+    const auto full=begin->render_area;
+    const uint64_t full_pixels=uint64_t(full.extent.width)*full.extent.height;
+    stats.original_pixels+=full_pixels;
+    if (enabled && safe && touched) {
+      // Expand to 32-pixel boundaries, clamped to the original area. This is
+      // conservative padding, not an assumption about the hardware tile size.
+      left=std::max<int64_t>(full.offset.x,(left/32)*32);
+      top=std::max<int64_t>(full.offset.y,(top/32)*32);
+      right=std::min(int64_t(full.offset.x)+full.extent.width,((right+31)/32)*32);
+      bottom=std::min(int64_t(full.offset.y)+full.extent.height,((bottom+31)/32)*32);
+      begin->render_area={{int32_t(left),int32_t(top)},
+                          {uint32_t(right-left),uint32_t(bottom-top)}};
+    }
+    const uint64_t used=uint64_t(begin->render_area.extent.width)*begin->render_area.extent.height;
+    stats.used_pixels+=used;
+    if (used<full_pixels) ++stats.reduced_passes;
+    begin=nullptr;
+  };
+  uintmax_t* stream=command_stream_.data();
+  size_t remaining=command_stream_.size();
+  while (remaining) {
+    const auto& header=*reinterpret_cast<const CommandHeader*>(stream);
+    stream+=kCommandHeaderSizeElements;remaining-=kCommandHeaderSizeElements;
+    switch (header.command) {
+      case Command::kVkBeginRendering: {
+        // Nested passes are invalid. Do not attempt to optimize malformed input.
+        if (begin) { safe=false;finish(); }
+        begin=reinterpret_cast<ArgsVkBeginRendering*>(stream);
+        safe=begin->flags==0 && begin->view_mask==0 && begin->layer_count==1;
+        touched=false;
+        const auto* attachments=reinterpret_cast<const VkRenderingAttachmentInfo*>(
+            reinterpret_cast<const uint8_t*>(stream)+
+            rex::align(sizeof(ArgsVkBeginRendering),alignof(VkRenderingAttachmentInfo)));
+        const uint32_t count=begin->color_attachment_count+uint32_t(begin->has_depth_attachment)+
+                             uint32_t(begin->has_stencil_attachment);
+        for (uint32_t i=0;i<count;++i) {
+          const auto& a=attachments[i];
+          if (a.imageView!=VK_NULL_HANDLE &&
+              (a.pNext || a.loadOp!=VK_ATTACHMENT_LOAD_OP_LOAD ||
+               a.storeOp!=VK_ATTACHMENT_STORE_OP_STORE || a.resolveMode!=VK_RESOLVE_MODE_NONE)) safe=false;
+        }
+      } break;
+      case Command::kVkSetScissor: {
+        const auto& args=*reinterpret_cast<const ArgsVkSetScissor*>(stream);
+        scissor_known=args.first_scissor==0 && args.scissor_count==1;
+        if (scissor_known) scissor=*reinterpret_cast<const VkRect2D*>(
+            reinterpret_cast<const uint8_t*>(stream)+rex::align(sizeof(ArgsVkSetScissor),alignof(VkRect2D)));
+      } break;
+      case Command::kVkDraw:
+      case Command::kVkDrawIndexed:
+        if (!scissor_known) safe=false;
+        else include(scissor);
+        break;
+      case Command::kVkClearAttachments: {
+        const auto& args=*reinterpret_cast<const ArgsVkClearAttachments*>(stream);
+        size_t offset=rex::align(sizeof(ArgsVkClearAttachments),alignof(VkClearAttachment));
+        offset=rex::align(offset+sizeof(VkClearAttachment)*args.attachment_count,alignof(VkClearRect));
+        const auto* rects=reinterpret_cast<const VkClearRect*>(reinterpret_cast<const uint8_t*>(stream)+offset);
+        for (uint32_t i=0;i<args.rect_count;++i) include(rects[i].rect);
+      } break;
+      case Command::kVkEndRendering: finish();break;
+      case Command::kVkBeginRenderPass:
+      case Command::kVkEndRenderPass:
+        if (begin) { safe=false;finish(); }
+        break;
+      default: break; // Other supported commands do not write framebuffer pixels.
+    }
+    stream+=header.arguments_size_elements;remaining-=header.arguments_size_elements;
+  }
+  // A missing EndRendering must not change the pass.
+  if (begin) { safe=false;finish(); }
+  return stats;
 }
 
