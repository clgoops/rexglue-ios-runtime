diff --git a/include/rex/ui/frame_metrics.h b/include/rex/ui/frame_metrics.h
new file mode 100644
--- /dev/null
+++ b/include/rex/ui/frame_metrics.h
@@ -0,0 +1,64 @@
+#pragma once
+#include <algorithm>
+#include <array>
+#include <atomic>
+#include <chrono>
+#include <cmath>
+#include <cstdint>
+#include <mutex>
+
+namespace rex::ui {
+struct GameFrameMetrics {
+  uint64_t frames = 0;
+  double mean_ms = 0, p95_ms = 0;
+  uint32_t width = 0, height = 0;
+};
+
+// Counts successful guest image refreshes, independently of UI repaint rate.
+// Optional recording costs only one atomic load when disabled.
+class GameFrameTracker {
+ public:
+  void SetEnabled(bool enabled) { enabled_.store(enabled, std::memory_order_relaxed); }
+  void Record(uint32_t width, uint32_t height) {
+    if (!enabled_.load(std::memory_order_relaxed)) return;
+    const auto ns = std::chrono::duration_cast<std::chrono::nanoseconds>(
+        std::chrono::steady_clock::now().time_since_epoch()).count();
+    RecordAt(uint64_t(ns), width, height);
+  }
+  void RecordAt(uint64_t ns, uint32_t width, uint32_t height) {
+    if (!enabled_.load(std::memory_order_relaxed) || !width || !height) return;
+    std::lock_guard lock(mutex_);
+    if (frames_ && ns <= last_ns_) return;
+    if (frames_) {
+      intervals_[next_] = double(ns - last_ns_) / 1e6;
+      next_ = (next_ + 1) % intervals_.size();
+      count_ = std::min(count_ + 1, intervals_.size());
+    }
+    last_ns_ = ns; ++frames_; width_ = width; height_ = height;
+  }
+  GameFrameMetrics Read() const {
+    std::array<double, 120> samples{};
+    size_t count;
+    GameFrameMetrics result;
+    {
+      std::lock_guard lock(mutex_);
+      result.frames = frames_; result.width = width_; result.height = height_;
+      samples = intervals_; count = count_;
+    }
+    if (count) {
+      for (size_t i=0; i<count; ++i) result.mean_ms += samples[i];
+      result.mean_ms /= double(count);
+      std::sort(samples.begin(), samples.begin() + count);
+      result.p95_ms = samples[size_t(std::ceil(double(count) * .95)) - 1];
+    }
+    return result;
+  }
+ private:
+  std::atomic<bool> enabled_{false};
+  mutable std::mutex mutex_;
+  std::array<double,120> intervals_{};
+  size_t next_=0, count_=0;
+  uint64_t last_ns_=0, frames_=0;
+  uint32_t width_=0, height_=0;
+};
+}
